# 後端 API 位址
# 本機開發：指向本機啟動的 online-shopping-api
# 正式環境：透過 next.config.mjs 的 rewrite 代理，維持與前台同源
NEXT_PUBLIC_API_URL=http://localhost:3000

# 圖片檔案位址（Cloudflare R2）
NEXT_PUBLIC_FILE_URL=https://pub-017e7bcd17494c71890e85da86b88d1a.r2.dev

# 站台網址，供 sitemap.xml 與 robots.txt 產生絕對路徑
# 未設定時預設為 http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3010
